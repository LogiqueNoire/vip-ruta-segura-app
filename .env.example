# Copia este archivo a .env y llena los valores.

# --- Base de datos (Neon: Dashboard > Connection string) ---
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Sesiones: cualquier texto largo y aleatorio (32+ caracteres) ---
SESSION_SECRET=

# --- Administrador (se crea o actualiza solo al arrancar) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador VIP

# --- Correo con Brevo (recomendado en Render gratis: va por HTTPS) ---
# Clave de API: app.brevo.com > SMTP y API > Claves de API
BREVO_API_KEY=
# Remitente ya verificado en Brevo (Remitentes y IP > Remitentes). Si lo dejas vacío usa GMAIL_USER.
BREVO_SENDER=

# --- Correo con Gmail (alternativa; se ignora si llenas BREVO_API_KEY) ---
# Cuenta desde la que salen los correos
GMAIL_USER=
# Opción A (Render gratis y cualquier hosting): API de Gmail por HTTPS. Pasos en el README.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Opción B (tu PC o un hosting que permita SMTP): contraseña de aplicación, https://myaccount.google.com/apppasswords
# Si llenas la opción A, esta se ignora.
GMAIL_APP_PASSWORD=

# --- Validación de DNI (token de https://apis.net.pe) ---
APIS_NET_PE_TOKEN=

# --- Opcionales ---
PORT=3000
# URL pública de la app (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000
# production activa cookies seguras (solo https)
NODE_ENV=development
